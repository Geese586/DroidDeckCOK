#!/bin/sh
# What the Steam client calls in Deck mode to look for a SteamOS update. There is no SteamOS
# here: the answer is "no update", which is exit 7 in SteamOS's convention, and the client moves
# on. --supports-duplicate-detection is a capability probe and answers yes. Staged from the apk.
case "${1:-}" in
  --supports-duplicate-detection) exit 0 ;;
esac
exit 7
