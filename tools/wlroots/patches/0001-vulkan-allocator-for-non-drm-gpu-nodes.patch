diff --git a/render/vulkan/allocator.c b/render/vulkan/allocator.c
new file mode 100644
index 00000000..4c00d361
--- /dev/null
+++ b/render/vulkan/allocator.c
@@ -0,0 +1,392 @@
+#include <assert.h>
+#include <drm_fourcc.h>
+#include <fcntl.h>
+#include <inttypes.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <wlr/interfaces/wlr_buffer.h>
+#include <wlr/render/allocator.h>
+#include <wlr/render/drm_format_set.h>
+#include <wlr/util/log.h>
+#include "render/vulkan.h"
+
+/*
+ * DMA-BUFs allocated by Vulkan, for a GPU whose device node is not a DRM device and so cannot be
+ * given to gbm - Adreno through KGSL on Android, where the node Turnip opens stands in for a
+ * render node. Each buffer is an exportable image with an explicit DRM format modifier, created
+ * the way vulkan_import_dmabuf() imports one for rendering, so the renderer and the parent
+ * compositor see the same layout. The device is our own, on the physical device the DRM fd names:
+ * this works under the gles2 renderer too, as long as its EGL can import the result.
+ */
+
+struct wlr_vk_allocator {
+	struct wlr_allocator base;
+	struct wlr_vk_device *dev;
+	PFN_vkGetMemoryFdKHR get_memory_fd;
+	PFN_vkGetImageDrmFormatModifierPropertiesEXT get_modifier_props;
+	struct wl_list buffers; // wlr_vk_allocator_buffer.link
+};
+
+struct wlr_vk_allocator_buffer {
+	struct wlr_buffer base;
+	struct wlr_vk_allocator *alloc; // NULL once the allocator is gone
+	struct wl_list link;
+	VkImage image;
+	VkDeviceMemory memory;
+	struct wlr_dmabuf_attributes dmabuf;
+};
+
+static const struct wlr_buffer_impl buffer_impl;
+
+static struct wlr_vk_allocator_buffer *buffer_from_buffer(struct wlr_buffer *wlr_buffer) {
+	assert(wlr_buffer->impl == &buffer_impl);
+	struct wlr_vk_allocator_buffer *buffer = wl_container_of(wlr_buffer, buffer, base);
+	return buffer;
+}
+
+static void buffer_release_vk(struct wlr_vk_allocator_buffer *buffer) {
+	if (buffer->alloc == NULL) {
+		return;
+	}
+	VkDevice dev = buffer->alloc->dev->dev;
+	// The exported DMA-BUF keeps the memory alive for whoever imported it.
+	if (buffer->image != VK_NULL_HANDLE) {
+		vkDestroyImage(dev, buffer->image, NULL);
+	}
+	if (buffer->memory != VK_NULL_HANDLE) {
+		vkFreeMemory(dev, buffer->memory, NULL);
+	}
+	buffer->image = VK_NULL_HANDLE;
+	buffer->memory = VK_NULL_HANDLE;
+	wl_list_remove(&buffer->link);
+	buffer->alloc = NULL;
+}
+
+static void buffer_destroy(struct wlr_buffer *wlr_buffer) {
+	struct wlr_vk_allocator_buffer *buffer = buffer_from_buffer(wlr_buffer);
+	wlr_buffer_finish(wlr_buffer);
+	buffer_release_vk(buffer);
+	wlr_dmabuf_attributes_finish(&buffer->dmabuf);
+	free(buffer);
+}
+
+static bool buffer_get_dmabuf(struct wlr_buffer *wlr_buffer,
+		struct wlr_dmabuf_attributes *dmabuf) {
+	struct wlr_vk_allocator_buffer *buffer = buffer_from_buffer(wlr_buffer);
+	*dmabuf = buffer->dmabuf;
+	return true;
+}
+
+static const struct wlr_buffer_impl buffer_impl = {
+	.destroy = buffer_destroy,
+	.get_dmabuf = buffer_get_dmabuf,
+};
+
+// One vkCreateImage over the modifiers that share the same mutable-sRGB setting, the one thing
+// in the import that depends on the modifier. The driver picks the modifier.
+static VkImage create_image(struct wlr_vk_allocator *alloc,
+		const struct wlr_vk_format_props *props, int width, int height,
+		const uint64_t *mods, uint32_t mods_len, bool mutable_srgb) {
+	VkImageCreateInfo img_info = {
+		.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+		.imageType = VK_IMAGE_TYPE_2D,
+		.format = props->format.vk,
+		.mipLevels = 1,
+		.arrayLayers = 1,
+		.samples = VK_SAMPLE_COUNT_1_BIT,
+		.sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+		.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED,
+		.extent = (VkExtent3D){ width, height, 1 },
+		.usage = vulkan_render_usage,
+		.tiling = VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT,
+	};
+	if (mutable_srgb) {
+		img_info.flags |= VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT;
+	}
+
+	VkExternalMemoryImageCreateInfo eimg = {
+		.sType = VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_IMAGE_CREATE_INFO,
+		.handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+	};
+	img_info.pNext = &eimg;
+
+	VkImageDrmFormatModifierListCreateInfoEXT mod_list = {
+		.sType = VK_STRUCTURE_TYPE_IMAGE_DRM_FORMAT_MODIFIER_LIST_CREATE_INFO_EXT,
+		.drmFormatModifierCount = mods_len,
+		.pDrmFormatModifiers = mods,
+	};
+	eimg.pNext = &mod_list;
+
+	VkFormat view_formats[] = {
+		props->format.vk,
+		props->format.vk_srgb,
+	};
+	VkImageFormatListCreateInfoKHR list_info = {
+		.sType = VK_STRUCTURE_TYPE_IMAGE_FORMAT_LIST_CREATE_INFO_KHR,
+		.pViewFormats = view_formats,
+		.viewFormatCount = sizeof(view_formats) / sizeof(view_formats[0]),
+	};
+	if (mutable_srgb) {
+		mod_list.pNext = &list_info;
+	}
+
+	VkImage image = VK_NULL_HANDLE;
+	VkResult res = vkCreateImage(alloc->dev->dev, &img_info, NULL, &image);
+	if (res != VK_SUCCESS) {
+		wlr_vk_error("vkCreateImage", res);
+		return VK_NULL_HANDLE;
+	}
+	return image;
+}
+
+static struct wlr_buffer *allocator_create_buffer(struct wlr_allocator *wlr_allocator,
+		int width, int height, const struct wlr_drm_format *format) {
+	struct wlr_vk_allocator *alloc = wl_container_of(wlr_allocator, alloc, base);
+	VkDevice dev = alloc->dev->dev;
+
+	const struct wlr_vk_format_props *props =
+		vulkan_format_props_from_drm(alloc->dev, format->format);
+	if (props == NULL) {
+		wlr_log(WLR_ERROR, "Vulkan allocator: format 0x%08"PRIX32" not supported",
+			format->format);
+		return NULL;
+	}
+
+	// The modifiers asked for that this device can render to at this size, split by whether the
+	// import will make the image mutable-format. INVALID (implicit) is not something Vulkan can
+	// allocate; LINEAR stands in for it when it is all there is.
+	uint64_t *mutable_mods = calloc(format->len + 1, sizeof(uint64_t));
+	uint64_t *plain_mods = calloc(format->len + 1, sizeof(uint64_t));
+	if (mutable_mods == NULL || plain_mods == NULL) {
+		free(mutable_mods);
+		free(plain_mods);
+		return NULL;
+	}
+	uint32_t mutable_len = 0, plain_len = 0;
+	bool implicit_only = format->len > 0;
+	for (size_t i = 0; i <= format->len; i++) {
+		uint64_t mod;
+		if (i < format->len) {
+			mod = format->modifiers[i];
+			if (mod == DRM_FORMAT_MOD_INVALID) {
+				continue;
+			}
+			implicit_only = false;
+		} else if (implicit_only) {
+			mod = DRM_FORMAT_MOD_LINEAR;
+		} else {
+			break;
+		}
+		const struct wlr_vk_format_modifier_props *mp =
+			vulkan_format_props_find_modifier(props, mod, true);
+		if (mp == NULL || (uint32_t)width > mp->max_extent.width ||
+				(uint32_t)height > mp->max_extent.height) {
+			continue;
+		}
+		if (mp->has_mutable_srgb) {
+			mutable_mods[mutable_len++] = mod;
+		} else {
+			plain_mods[plain_len++] = mod;
+		}
+	}
+
+	VkImage image = VK_NULL_HANDLE;
+	if (mutable_len > 0) {
+		image = create_image(alloc, props, width, height, mutable_mods, mutable_len, true);
+	}
+	if (image == VK_NULL_HANDLE && plain_len > 0) {
+		image = create_image(alloc, props, width, height, plain_mods, plain_len, false);
+	}
+	free(mutable_mods);
+	free(plain_mods);
+	if (image == VK_NULL_HANDLE) {
+		wlr_log(WLR_ERROR, "Vulkan allocator: no usable modifier for %dx%d format 0x%08"PRIX32,
+			width, height, format->format);
+		return NULL;
+	}
+
+	struct wlr_vk_allocator_buffer *buffer = calloc(1, sizeof(*buffer));
+	if (buffer == NULL) {
+		vkDestroyImage(dev, image, NULL);
+		return NULL;
+	}
+	wlr_buffer_init(&buffer->base, &buffer_impl, width, height);
+	buffer->alloc = alloc;
+	buffer->image = image;
+	wl_list_insert(&alloc->buffers, &buffer->link);
+	for (int i = 0; i < WLR_DMABUF_MAX_PLANES; i++) {
+		buffer->dmabuf.fd[i] = -1;
+	}
+
+	VkMemoryRequirements reqs;
+	vkGetImageMemoryRequirements(dev, image, &reqs);
+	int mem_type = vulkan_find_mem_type(alloc->dev,
+		VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT, reqs.memoryTypeBits);
+	if (mem_type < 0) {
+		mem_type = vulkan_find_mem_type(alloc->dev, 0, reqs.memoryTypeBits);
+	}
+	if (mem_type < 0) {
+		wlr_log(WLR_ERROR, "Vulkan allocator: no memory type for the image");
+		goto error;
+	}
+
+	VkMemoryDedicatedAllocateInfo dedicated = {
+		.sType = VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO,
+		.image = image,
+	};
+	VkExportMemoryAllocateInfo export = {
+		.sType = VK_STRUCTURE_TYPE_EXPORT_MEMORY_ALLOCATE_INFO,
+		.pNext = &dedicated,
+		.handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+	};
+	VkMemoryAllocateInfo mem_info = {
+		.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+		.pNext = &export,
+		.allocationSize = reqs.size,
+		.memoryTypeIndex = mem_type,
+	};
+	VkResult res = vkAllocateMemory(dev, &mem_info, NULL, &buffer->memory);
+	if (res != VK_SUCCESS) {
+		wlr_vk_error("vkAllocateMemory", res);
+		goto error;
+	}
+	res = vkBindImageMemory(dev, image, buffer->memory, 0);
+	if (res != VK_SUCCESS) {
+		wlr_vk_error("vkBindImageMemory", res);
+		goto error;
+	}
+
+	VkImageDrmFormatModifierPropertiesEXT mod_props = {
+		.sType = VK_STRUCTURE_TYPE_IMAGE_DRM_FORMAT_MODIFIER_PROPERTIES_EXT,
+	};
+	res = alloc->get_modifier_props(dev, image, &mod_props);
+	if (res != VK_SUCCESS) {
+		wlr_vk_error("vkGetImageDrmFormatModifierPropertiesEXT", res);
+		goto error;
+	}
+	const struct wlr_vk_format_modifier_props *mp =
+		vulkan_format_props_find_modifier(props, mod_props.drmFormatModifier, true);
+	if (mp == NULL) {
+		wlr_log(WLR_ERROR, "Vulkan allocator: driver chose modifier 0x%016"PRIX64
+			" which it cannot render to", mod_props.drmFormatModifier);
+		goto error;
+	}
+	uint32_t n_planes = mp->props.drmFormatModifierPlaneCount;
+	if (n_planes == 0 || n_planes > WLR_DMABUF_MAX_PLANES) {
+		wlr_log(WLR_ERROR, "Vulkan allocator: %"PRIu32" memory planes", n_planes);
+		goto error;
+	}
+
+	VkMemoryGetFdInfoKHR fd_info = {
+		.sType = VK_STRUCTURE_TYPE_MEMORY_GET_FD_INFO_KHR,
+		.memory = buffer->memory,
+		.handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+	};
+	int fd = -1;
+	res = alloc->get_memory_fd(dev, &fd_info, &fd);
+	if (res != VK_SUCCESS || fd < 0) {
+		wlr_vk_error("vkGetMemoryFdKHR", res);
+		goto error;
+	}
+
+	buffer->dmabuf = (struct wlr_dmabuf_attributes){
+		.width = width,
+		.height = height,
+		.format = format->format,
+		.modifier = mod_props.drmFormatModifier,
+		.n_planes = n_planes,
+	};
+	for (int i = 0; i < WLR_DMABUF_MAX_PLANES; i++) {
+		buffer->dmabuf.fd[i] = -1;
+	}
+	static const VkImageAspectFlagBits plane_aspects[] = {
+		VK_IMAGE_ASPECT_MEMORY_PLANE_0_BIT_EXT,
+		VK_IMAGE_ASPECT_MEMORY_PLANE_1_BIT_EXT,
+		VK_IMAGE_ASPECT_MEMORY_PLANE_2_BIT_EXT,
+		VK_IMAGE_ASPECT_MEMORY_PLANE_3_BIT_EXT,
+	};
+	for (uint32_t i = 0; i < n_planes; i++) {
+		VkImageSubresource sub = { .aspectMask = plane_aspects[i] };
+		VkSubresourceLayout layout;
+		vkGetImageSubresourceLayout(dev, image, &sub, &layout);
+		buffer->dmabuf.offset[i] = layout.offset;
+		buffer->dmabuf.stride[i] = layout.rowPitch;
+		// Every plane lives in the one allocation; each gets its own fd, as
+		// wlr_dmabuf_attributes_finish() closes them one by one.
+		buffer->dmabuf.fd[i] = i == 0 ? fd : fcntl(fd, F_DUPFD_CLOEXEC, 0);
+		if (buffer->dmabuf.fd[i] < 0) {
+			wlr_log_errno(WLR_ERROR, "Vulkan allocator: dup failed");
+			goto error;
+		}
+	}
+
+	wlr_log(WLR_DEBUG, "Vulkan allocator: %dx%d format 0x%08"PRIX32" modifier 0x%016"PRIX64
+		", %"PRIu32" plane(s)", width, height, format->format, mod_props.drmFormatModifier, n_planes);
+	return &buffer->base;
+
+error:
+	buffer_destroy(&buffer->base);
+	return NULL;
+}
+
+static void allocator_destroy(struct wlr_allocator *wlr_allocator) {
+	struct wlr_vk_allocator *alloc = wl_container_of(wlr_allocator, alloc, base);
+	// Buffers may outlive their allocator; their DMA-BUF fds stay valid without the device.
+	struct wlr_vk_allocator_buffer *buffer, *tmp;
+	wl_list_for_each_safe(buffer, tmp, &alloc->buffers, link) {
+		buffer_release_vk(buffer);
+	}
+	struct wlr_vk_instance *ini = alloc->dev->instance;
+	vulkan_device_destroy(alloc->dev);
+	vulkan_instance_destroy(ini);
+	free(alloc);
+}
+
+static const struct wlr_allocator_interface allocator_impl = {
+	.destroy = allocator_destroy,
+	.create_buffer = allocator_create_buffer,
+};
+
+struct wlr_allocator *vulkan_allocator_create(int drm_fd) {
+	struct wlr_vk_instance *ini = vulkan_instance_create(false);
+	if (ini == NULL) {
+		wlr_log(WLR_ERROR, "Vulkan allocator: could not create an instance");
+		return NULL;
+	}
+	VkPhysicalDevice phdev = vulkan_find_drm_phdev(ini, drm_fd);
+	if (phdev == VK_NULL_HANDLE) {
+		wlr_log(WLR_ERROR, "Vulkan allocator: no Vulkan device for the DRM fd");
+		vulkan_instance_destroy(ini);
+		return NULL;
+	}
+	struct wlr_vk_device *dev = vulkan_device_create(ini, phdev);
+	if (dev == NULL) {
+		wlr_log(WLR_ERROR, "Vulkan allocator: could not create a device");
+		vulkan_instance_destroy(ini);
+		return NULL;
+	}
+
+	struct wlr_vk_allocator *alloc = calloc(1, sizeof(*alloc));
+	if (alloc == NULL) {
+		vulkan_device_destroy(dev);
+		vulkan_instance_destroy(ini);
+		return NULL;
+	}
+	alloc->dev = dev;
+	wl_list_init(&alloc->buffers);
+	alloc->get_memory_fd = (PFN_vkGetMemoryFdKHR)
+		vkGetDeviceProcAddr(dev->dev, "vkGetMemoryFdKHR");
+	alloc->get_modifier_props = (PFN_vkGetImageDrmFormatModifierPropertiesEXT)
+		vkGetDeviceProcAddr(dev->dev, "vkGetImageDrmFormatModifierPropertiesEXT");
+	if (alloc->get_memory_fd == NULL || alloc->get_modifier_props == NULL) {
+		wlr_log(WLR_ERROR, "Vulkan allocator: the device lacks DMA-BUF export");
+		free(alloc);
+		vulkan_device_destroy(dev);
+		vulkan_instance_destroy(ini);
+		return NULL;
+	}
+
+	wlr_allocator_init(&alloc->base, &allocator_impl, WLR_BUFFER_CAP_DMABUF);
+	wlr_log(WLR_INFO, "Created Vulkan DMA-BUF allocator");
+	return &alloc->base;
+}
