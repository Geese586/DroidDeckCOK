# Auto detect text files and perform LF normalization
* text=auto

tools/linuxfs/** text=auto eol=lf
tools/mangoapp/** text=auto eol=lf
# 0.5.0's VR sources: the C/C++ under tools/vr is compiled on a Linux container and diffed against
# upstream at every merge, so a Windows checkout must not hand make-archive.py a CRLF copy of it -
# that is what turns one changed line into a whole-file patch. (DroidDeckCOK)
tools/vr/** text=auto eol=lf
tools/comet/LICENSE whitespace=-blank-at-eof
tools/comet/droiddeck.patch whitespace=-blank-at-eol,-blank-at-eof

# These helpers are packaged verbatim and executed inside the Linux runtime.
tools/linuxfs/overlay/** text eol=lf
tools/linuxfs/desktop/** text eol=lf
tools/mangoapp/mangoapp text eol=lf
app/src/main/assets/desktop-removal/*.json text eol=lf
app/src/main/assets/desktop-removal/*.txt text eol=lf
*.pdf binary
